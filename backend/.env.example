# 사고 이미지 기능에 필요한 환경변수 — 실제 값은 여기 적지 않는다.
#
# 이 파일은 "무엇을 채워야 하는가" 만 알려준다. 실제 버킷명·키는 배포 파이프라인의
# 시크릿에 두고 저장소에 커밋하지 않는다. AWS 액세스 키는 이 목록에 없다 —
# 자격증명은 기본 체인(로컬 `aws configure` 프로필, 배포 서버 EC2 IAM 역할)에서만 온다
# (common/storage/ObjectStorageProperties Javadoc).
#
# 사용법
#   로컬  : 이 파일을 backend/.env 로 복사해 값을 채우고 IDE 실행 구성에 연결
#   배포  : CI/CD 변수 또는 컨테이너 환경변수로 주입
#
# ─────────────────────────────────────────────────────────────────────────────
# 사고 이미지 (필수)
# ─────────────────────────────────────────────────────────────────────────────
# 둘 다 값이 있어야 S3 어댑터 빈이 만들어진다. 하나라도 비면 어댑터가 뜨지 않고
# 업로드 URL 발급·완료 통보·삭제가 503 SERVICE_UNAVAILABLE 로 응답한다.
# (목록 조회 GET /api/accidents/{id}/images 는 저장소 없이도 200 이다 — URL 만 null 이 된다.)
#
# ⚠️ 두 값을 절대 바꿔 쓰지 마라.
#   staging : 브라우저가 presigned PUT 으로 직접 올리는 원본(ORIGINAL). EXIF 가 남아 있고 7일 뒤 자동 삭제된다
#   service : 서버가 만든 파생본(RESIZED·THUMBNAIL). 화면에 나가는 것은 여기뿐이고 영구 보관이다
#   바꿔 넣으면 원본이 영구 버킷에 남고 파생본이 7일 뒤 사라져 이미지가 조용히 깨진다.
STORAGE_STAGING_BUCKET=
STORAGE_SERVICE_BUCKET=

# 리전. 비워 두면 SDK 가 GetBucketLocation 을 부르는데 팀 IAM 정책에 그 액션이 없어
# AccessDenied 로 죽는다. application.properties 의 기본값은 ap-northeast-2 다.
AWS_REGION=ap-northeast-2

# ─────────────────────────────────────────────────────────────────────────────
# 프로필 이미지 (선택 — 없으면 프로필 이미지 API 만 503)
# ─────────────────────────────────────────────────────────────────────────────
PROFILE_IMAGE_STAGING_BUCKET=
PROFILE_IMAGE_SERVICE_BUCKET=

# ─────────────────────────────────────────────────────────────────────────────
# 견적서 검증 (선택 — 사고 이미지와 무관)
# ─────────────────────────────────────────────────────────────────────────────
# s3 또는 local 중 정확히 하나. 둘 다 켜지면 DocumentStoragePort 빈이 두 개가 되어 기동이 실패한다.
DOCUMENT_STORAGE_PROVIDER=
ESTIMATE_OCR_PROVIDER=
GMS_KEY=
ESTIMATE_WORKER_ENABLED=false
VALIDATION_PDF_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# 프론트엔드
# ─────────────────────────────────────────────────────────────────────────────
# OAuth 성공·실패 후 리다이렉트할 프론트 기준 URL.
# ⚠️ CORS 허용 오리진은 아직 이 값을 따르지 않고 config/SecurityConfig 에 하드코딩돼 있다.
#    배포 도메인에서 쓰려면 코드 수정이 필요하다(별도 이슈).
FRONTEND_BASE_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# 필요한 IAM 권한 (버킷 두 개에 대해)
# ─────────────────────────────────────────────────────────────────────────────
#   s3:PutObject     presigned PUT · 파생본 저장
#   s3:GetObject     원본 읽기 · presigned GET(조회 URL)
#   s3:HeadObject    완료 통보의 3단 재검증(실제 크기 확인)
#   s3:DeleteObject  이미지 삭제 · 실패분 정리
#   s3:ListBucket    (선택) 운영 확인용
# GetBucketLocation 은 필요하지 않다 — 리전을 코드에서 명시하므로 SDK 가 묻지 않는다.
