# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 git 에 올라가지 않는다.

# 카카오 지도 JavaScript 키 (주변 정비소 화면). 카카오 콘솔 > 플랫폼 > Web 에 http://localhost:5173 등록 필요
VITE_KAKAO_JS_KEY=

# 백엔드 주소. 소셜 로그인 진입(/oauth2/authorization/kakao)과 모든 API 호출의 기준 URL
VITE_API_BASE_URL=http://localhost:8080

# 백엔드 없이 화면만 볼 때 라우터 로그인 가드를 끈다 (개발용). 값이 off 일 때만 동작
# VITE_AUTH_GUARD=off
