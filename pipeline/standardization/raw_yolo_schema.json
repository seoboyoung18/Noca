{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bareun-gyeonjeok.example/schemas/yolo-raw-1.0.0.json",
  "title": "Bareun Quote YOLO raw model output",
  "description": "Canonical raw contract aligned with the Notion page YOLO 출력 형식 (공유용). This is the model-developer contract before domain normalization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "image", "predictions"],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "task"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "task": {"type": "string", "enum": ["detect", "segment"]}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id", "original_width", "original_height"],
      "properties": {
        "image_id": {"type": ["string", "integer"], "minLength": 1},
        "original_width": {"type": "integer", "minimum": 1},
        "original_height": {"type": "integer", "minimum": 1}
      }
    },
    "predictions": {
      "type": "array",
      "items": {"$ref": "#/$defs/prediction"}
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "segmentation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["format", "polygons"],
      "properties": {
        "format": {"const": "polygon"},
        "polygons": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "items": {"$ref": "#/$defs/point"}
          }
        }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "coordinates"],
      "properties": {
        "format": {"const": "xyxy"},
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": 0},
            {"type": "number", "minimum": 0},
            {"type": "number", "minimum": 0},
            {"type": "number", "minimum": 0}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_id", "class_id", "class_name", "confidence", "bbox", "segmentation"],
      "properties": {
        "detection_id": {"type": "string", "minLength": 1},
        "class_id": {"type": "integer", "minimum": 0},
        "class_name": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "segmentation": {"$ref": "#/$defs/segmentation"}
      }
    }
  }
}
